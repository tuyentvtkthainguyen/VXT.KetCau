<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KetCauVXT.App</RootNamespace>
    <AssemblyName>KetCauVXT</AssemblyName>
    <Product>Việt Const</Product>
    <AssemblyTitle>Việt Const – thiết kế kết cấu nhà dân dụng và khung thép tiền chế</AssemblyTitle>
    <Authors>Vũ Xuân Tuyến</Authors>
    <Version>1.0.0</Version>
    <ApplicationIcon>KetCauVXT.ico</ApplicationIcon>
    <NoWarn>CS1591;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- biểu tượng cửa sổ (Window.Icon) -->
    <Resource Include="KetCauVXT.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../KetCauVXT.Core/KetCauVXT.Core.csproj" />
    <!-- đọc DWG (ACadSharp, MIT) – đăng ký vào lõi trong App.xaml.cs -->
    <ProjectReference Include="../KetCauVXT.Dwg/KetCauVXT.Dwg.csproj" />
  </ItemGroup>

</Project>
