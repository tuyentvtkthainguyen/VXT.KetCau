<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KetCauVXT.App</RootNamespace>
    <AssemblyName>KetCauVXT</AssemblyName>
    <Product>Kết cấu VXT</Product>
    <AssemblyTitle>Kết cấu VXT – thiết kế kết cấu nhà dân dụng và khung thép tiền chế</AssemblyTitle>
    <Authors>Vũ Xuân Tuyến</Authors>
    <Version>1.0.0</Version>
    <NoWarn>CS1591;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../KetCauVXT.Core/KetCauVXT.Core.csproj" />
  </ItemGroup>

</Project>
