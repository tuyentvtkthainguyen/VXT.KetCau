<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Kết nối ETABS 21/22/23 và SAP2000 v25/v26 qua CSi OAPI chung (CSiAPIv1.dll).
    Đặt CsiApiDir trong Directory.Build.props hoặc: dotnet build -p:CsiApiDir="C:\Program Files\Computers and Structures\ETABS 23"
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <RootNamespace>VXT.KetCau.Csi</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VXT.KetCau.Core\VXT.KetCau.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CSiAPIv1">
      <HintPath>$(CsiApiDir)\CSiAPIv1.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>
</Project>
