<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Add-in Revit đa phiên bản. Chọn cấu hình khi build:
      dotnet build -c "Release R22"   (Revit 2022, .NET Framework 4.8)
      dotnet build -c "Release R23"   (Revit 2023)
      dotnet build -c "Release R24"   (Revit 2024)
      dotnet build -c "Release R25"   (Revit 2025, .NET 8)
      dotnet build -c "Release R26"   (Revit 2026, .NET 8)
    Thư viện Revit API lấy từ NuGet (Nice3point.Revit.Api.*) nên không cần cài Revit để build.
  -->
  <PropertyGroup>
    <Configurations>Debug R22;Debug R23;Debug R24;Debug R25;Debug R26;Release R22;Release R23;Release R24;Release R25;Release R26</Configurations>
    <RootNamespace>VXT.KetCau.Revit</RootNamespace>
    <AssemblyName>VXT.KetCau.Revit</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.Contains('R22'))">
    <RevitVersion>2022</RevitVersion>
    <TargetFramework>net48</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2022</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R23'))">
    <RevitVersion>2023</RevitVersion>
    <TargetFramework>net48</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2023;REVIT2023_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R24'))">
    <RevitVersion>2024</RevitVersion>
    <TargetFramework>net48</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2024;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R25'))">
    <RevitVersion>2025</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2025;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('R26'))">
    <RevitVersion>2026</RevitVersion>
    <TargetFramework>net8.0-windows</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2026;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER;REVIT2025_OR_GREATER;REVIT2026_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RevitVersion)' == ''">
    <!-- Mặc định khi mở bằng Visual Studio không chọn cấu hình -->
    <RevitVersion>2024</RevitVersion>
    <TargetFramework>net48</TargetFramework>
    <DefineConstants>$(DefineConstants);REVIT2024;REVIT2023_OR_GREATER;REVIT2024_OR_GREATER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AddinDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</AddinDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VXT.KetCau.Core\VXT.KetCau.Core.csproj" />
    <ProjectReference Include="..\VXT.KetCau.Dwg\VXT.KetCau.Dwg.csproj" />
    <ProjectReference Include="..\VXT.KetCau.Csi\VXT.KetCau.Csi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="VXT.KetCau.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Sau khi build Release: chép add-in vào thư mục Addins của đúng phiên bản Revit -->
  <Target Name="DeployAddin" AfterTargets="Build" Condition="$(Configuration.StartsWith('Release'))">
    <ItemGroup>
      <AddinFiles Include="$(OutputPath)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="$(OutputPath)VXT.KetCau.addin" DestinationFolder="$(AddinDir)" />
    <Copy SourceFiles="@(AddinFiles)" DestinationFolder="$(AddinDir)\VXT.KetCau\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
