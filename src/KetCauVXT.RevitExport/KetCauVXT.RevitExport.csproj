<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Add-in Revit xuất mô hình kết cấu sang Kết cấu VXT (file *.vxtrevit.json).

    Chọn phiên bản: dotnet build -p:RevitVersion=2025 (mặc định 2024).
    Revit ≤ 2024 → .NET Framework 4.8; Revit 2025, 2026 → .NET 8 (tự chọn).
    Không cài Revit: tự dùng gói tham chiếu Nice3point.Revit.Api trên NuGet.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <!-- Revit 2025 trở đi chạy trên .NET 8 -->
    <TargetFramework Condition="$(RevitVersion) &gt;= 2025">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &lt; 2025">net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWindowsForms Condition="'$(TargetFramework)' != 'net48'">true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>KetCauVXT.RevitExport</RootNamespace>
    <AssemblyName>KetCauVXT.RevitExport</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Vũ Xuân Tuyến</Authors>
    <Product>Kết cấu VXT – xuất từ Revit</Product>
    <RevitDir>C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitDir>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Máy có cài Revit: tham chiếu DLL trong thư mục cài đặt. Máy không có Revit (CI): dùng gói tham chiếu Nice3point.Revit.Api. -->
  <PropertyGroup>
    <UseRevitNuGet Condition="'$(UseRevitNuGet)' == '' And !Exists('$(RevitDir)RevitAPI.dll')">true</UseRevitNuGet>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseRevitNuGet)' == 'true'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseRevitNuGet)' != 'true'">
    <Reference Include="RevitAPI">
      <HintPath>$(RevitDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- .NET Framework 4.8 không có System.Text.Json: add-in tự ghi JSON bằng JsonWriter.cs (không cần NuGet). -->

  <ItemGroup>
    <None Update="KetCauVXT.RevitExport.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
