<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
  Chép file này và KetCauVXT.RevitExport.dll vào:
    %AppData%\Autodesk\Revit\Addins\2024\
  (sửa đường dẫn <Assembly> nếu đặt DLL ở thư mục khác).
-->
<RevitAddIns>
  <AddIn Type="Command">
    <Name>Xuất sang Việt Const</Name>
    <Text>Xuất sang Việt Const</Text>
    <Description>Xuất trục, tầng, cột, dầm, sàn kết cấu sang file JSON cho chương trình Việt Const</Description>
    <Assembly>KetCauVXT.RevitExport.dll</Assembly>
    <FullClassName>KetCauVXT.RevitExport.ExportCommand</FullClassName>
    <ClientId>6b1d6f2e-5c0a-4a37-9e1b-2f7c4f0d8a11</ClientId>
    <VendorId>VXT</VendorId>
    <VendorDescription>Vũ Xuân Tuyến – Việt Const</VendorDescription>
    <VisibilityMode>NotVisibleInFamily</VisibilityMode>
  </AddIn>
  <AddIn Type="Command">
    <Name>Đưa họ vào thư viện Việt Const</Name>
    <Text>Đưa họ vào thư viện Việt Const</Text>
    <Description>Ghi hình học các loại họ (đồ đạc, thiết bị vệ sinh, đèn, cửa…) đang chọn vào thư viện 3D của Việt Const (%AppData%\VietConst\ThuVien3D)</Description>
    <Assembly>KetCauVXT.RevitExport.dll</Assembly>
    <FullClassName>KetCauVXT.RevitExport.ExportLibraryCommand</FullClassName>
    <ClientId>8e4c2a1d-3f6b-4b7e-9a2c-5d1f0e7b6c32</ClientId>
    <VendorId>VXT</VendorId>
    <VendorDescription>Vũ Xuân Tuyến – Việt Const</VendorDescription>
    <VisibilityMode>NotVisibleInFamily</VisibilityMode>
  </AddIn>
</RevitAddIns>
