<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Đọc / ghi bản vẽ DWG cho Kết cấu VXT bằng thư viện ACadSharp (mã nguồn mở, giấy phép MIT – github.com/DomCR/ACadSharp).
    Tách riêng khỏi KetCauVXT.Core để lõi tính toán không dùng gói NuGet nào; App và bộ kiểm thử đăng ký
    bộ đọc vào lõi qua KetCauVXT.Import.CadFileReaders.Dwg.
    ACadSharp (net8.0) không phụ thuộc gói nào khác (CSMath, CSUtilities được biên dịch sẵn bên trong).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>KetCauVXT.Dwg</RootNamespace>
    <AssemblyName>KetCauVXT.Dwg</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Vũ Xuân Tuyến</Authors>
    <Product>Kết cấu VXT</Product>
    <NoWarn>CS1591;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="[3.8.35]" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../KetCauVXT.Core/KetCauVXT.Core.csproj" />
  </ItemGroup>

</Project>
